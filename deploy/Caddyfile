# SPA y API en el mismo origen (sección 7.1). Caddy escucha en 8080 dentro del contenedor (sin root).
{
	admin off
	auto_https off

	servers {
		# Solo se cree en las cabeceras de IP de quien conecta desde un proxy conocido (p. ej. cloudflared).
		# Acótalo con TRUSTED_PROXY_RANGES (IP o CIDR separados por espacio); por defecto, redes privadas.
		trusted_proxies static {$TRUSTED_PROXY_RANGES:private_ranges}
		# Detrás de cloudflared la IP real llega en CF-Connecting-IP; si no, en X-Forwarded-For.
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Las métricas son solo para la red interna de Compose, nunca por el proxy público.
	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
