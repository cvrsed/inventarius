# Copiar a .env y completar. Nunca commitear .env.
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
APP_TIMEZONE=America/Santiago

# Conexión de la app (usuario con DML) y del migrador (usuario con DDL)
DATABASE_URL=postgres://inventarius_app:change-me-app@localhost:5432/inventarius
MIGRATION_DATABASE_URL=postgres://inventarius_migrator:change-me-migrator@localhost:5432/inventarius

# Variables que usa solo el contenedor de Postgres de compose.yml
POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app
MIGRATOR_DB_PASSWORD=change-me-migrator

# Token para /api/metrics fuera de la red interna (vacío = solo red interna)
METRICS_TOKEN=

# Prefijo de la etiqueta autogenerada de activos (RF-20)
ASSET_TAG_PREFIX=INV

# Moneda por defecto del costo de compra (código ISO 4217)
DEFAULT_CURRENCY=CLP

# Proxies de los que la API acepta X-Forwarded-For (IP, CIDR o loopback/linklocal/uniquelocal, separados por coma).
# En producción conviene acotarlo a la IP de Caddy; vacío = no confiar en ninguno.
TRUSTED_PROXIES=loopback,uniquelocal

# Quién puede informar la IP del cliente a Caddy (p. ej. cloudflared), separados por espacio. Lo lee Caddy, no la API.
TRUSTED_PROXY_RANGES=private_ranges

# Sesión: inactividad máxima y duración absoluta, en segundos (8 h y 24 h)
SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
# Cookie Secure con prefijo __Host- (exige HTTPS). Por defecto true solo en producción; descomentar para forzar.
# SESSION_COOKIE_SECURE=true

# Bloqueo de login: fallos por cuenta y por IP, y segundos de bloqueo base y máximo
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=1800

# Límites de peticiones por minuto y por IP: login y global
LOGIN_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_MAX_PER_MINUTE=600
