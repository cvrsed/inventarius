{
  "name": "@inventarius/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=inventarius-source --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --conditions=inventarius-source --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx --conditions=inventarius-source --env-file-if-exists=../../.env src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --project int",
    "cli": "tsx --conditions=inventarius-source --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@chirpstack/chirpstack-api": "4.20.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.4",
    "@fastify/under-pressure": "9.2.1",
    "@grpc/grpc-js": "1.14.7",
    "@inventarius/shared": "workspace:*",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-metrics": "15.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
